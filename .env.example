# Core output
OUTPUT_FILENAME=products.json

# Network and API
REQUEST_TIMEOUT=15
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Selenium defaults
BROWSER_HEADLESS=false
BROWSER_USE_UNDETECTED=true
BROWSER_USE_PROFILE=true
BROWSER_USER_DATA_DIR=./chrome_profile
BROWSER_PROFILE_DIRECTORY=Default
CHALLENGE_WAIT_SECONDS=300

# Compliant LinkedIn adapter (optional)
# When target URL is linkedin.com, the scraper will call this provider instead of scraping LinkedIn pages.
LINKEDIN_PROVIDER_URL=
LINKEDIN_PROVIDER_TOKEN=
